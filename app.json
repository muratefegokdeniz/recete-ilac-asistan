{
  "expo": {
    "name": "İlaç Asistanı",
    "slug": "recete-ilac-asistan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "ilacasistan",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5faf8"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Reçete ve ilaç fotoğrafı çekmek için kamera erişimi gerekiyor.",
        "NSPhotoLibraryUsageDescription": "Galerinizden reçete veya ilaç fotoğrafı seçmek için erişim gerekiyor.",
        "NSUserNotificationsUsageDescription": "İlaç hatırlatmaları için bildirim izni gerekiyor."
      }
    },
    "android": {
      "package": "com.muratefegokdeniz.receteilacasistan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f5faf8"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00685f"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Galerinizden ilaç fotoğrafı seçmek için erişim gerekiyor.",
          "cameraPermission": "Reçete ve ilaç fotoğrafı çekmek için kamera erişimi gerekiyor."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "./plugins/withFixAndroidPackage.js"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d25d8e60-7587-44c4-be80-547ed12e5a7f"
      }
    },
    "owner": "muratefegokdeniz",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d25d8e60-7587-44c4-be80-547ed12e5a7f"
    }
  }
}
